# ============================================================
# AFRIXORA — Environment Variables (example)
# Copier ce fichier en .env et remplacer les valeurs
# ============================================================
# NODE_ENV=production

# Base de données (PostgreSQL / TimescaleDB)
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://afrixora:CHANGE_ME@postgres:5432/afrixora_prod

# Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379

# JWT (HS256) — Générer avec : openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MQTT
MQTT_URL=mqtt://mosquitto:1883
MQTT_API_USER=afrixora_api
MQTT_API_PASSWORD=CHANGE_ME

# Email (Resend)
RESEND_API_KEY=re_CHANGE_ME

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=https://api.afrixora.cd

# Domaine et CORS
DOMAIN=afrixora.cd
CORS_ORIGINS=https://afrixora.cd,http://localhost:3000

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Monitoring (Grafana)
GRAFANA_PASSWORD=CHANGE_ME

# Business
ENERGY_COST_PER_KWH=0.12