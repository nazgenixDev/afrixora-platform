# ============================================================
# AFRIXORA — Environment Variables (example)
# Copier ce fichier en .env et remplacer les valeurs
# ============================================================
# NODE_ENV=production

# Base de données (PostgreSQL / TimescaleDB)
DB_PASSWORD=CHANGE_ME
# Secrets distincts. Copier la valeur de DB_API_PASSWORD dans la chaîne utilisée hors Compose.
DB_API_PASSWORD=CHANGE_ME
DB_GRAFANA_PASSWORD=CHANGE_ME
DB_BACKUP_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://afrixora_api:CHANGE_ME@postgres:5432/afrixora_prod
RETENTION_DAYS=365

# Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://afrixora_api:CHANGE_ME@redis:6379

# JWT (HS256) — Générer avec : openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MQTT
MQTT_URL=mqtt://mosquitto:1883
MQTT_API_USER=afrixora_api
MQTT_API_PASSWORD=CHANGE_ME
# MQTT_AUTH_PATH=./infrastructure/docker/mqtt-auth

# Email (Resend)
RESEND_API_KEY=re_CHANGE_ME
# Facultatif. Adresse d’un domaine expéditeur vérifié dans Resend.
RESEND_FROM=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=https://api.afrixora.cd

# Domaine et CORS
DOMAIN=afrixora.cd
CORS_ORIGINS=https://afrixora.cd
# Nombre de proxys de confiance. Utiliser 0 si les clients accèdent directement à l’API.
# Cloudflare Tunnel → Traefik → API utilise 2, à valider sur le serveur.
# L’API doit être accessible uniquement via la chaîne configurée, qui doit normaliser X-Forwarded-For.
TRUST_PROXY_HOPS=2

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# Adapter uniquement si ce sous-réseau recouvre un réseau de l’hôte.
# TUNNEL_INGRESS_SUBNET=10.253.247.0/29

# Monitoring (Grafana)
GRAFANA_PASSWORD=CHANGE_ME

# Sauvegardes. Seul le certificat public est monté dans le conteneur.
# BACKUP_CERT_PATH=./infrastructure/docker/backup-cert.pem
# BACKUP_STORAGE_PATH=./backups

# Business
ENERGY_COST_PER_KWH=0.12

# Seed — mot de passe du compte admin créé par `prisma db seed`
# En production, le seed REFUSE de s'exécuter si cette variable est absente
# ou vaut CHANGE_ME. Le compte de démo ne doit jamais exister en production.
SEED_ADMIN_PASSWORD=CHANGE_ME
