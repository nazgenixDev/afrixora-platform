{
  "name": "afrixora-backend",
  "version": "0.1.0",
  "description": "AFRIXORA Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch -r ts-node/register/transpile-only src/server.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/assets', 'dist/assets', { recursive: true })\"",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/v2_p0_isolated.test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.16.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.11.3",
    "resend": "^6.12.4",
    "socket.io": "^4.8.4",
    "winston": "^3.11.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prisma": "^5.7.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "engine.io": "^6.6.12",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.23.0",
    "ip-address": "^10.7.6",
    "brace-expansion@1": "^1.1.21",
    "js-yaml": "^4.3.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.9"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "NAZGENIX SAS",
  "license": "UNLICENSED",
  "private": true,
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
