generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT ──────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(CORE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
  buildings Building[]
}

enum Plan {
  CORE
  COMFORT
  ENTERPRISE
}

// ─── USER ────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OPERATOR)
  jwtVersion   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  BUILDING_ADMIN
  OPERATOR
  VIEWER
}

// ─── BUILDING ────────────────────────────────────────────────
model Building {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  address    String
  city       String   @default("Lubumbashi")
  unitsCount Int      @default(0)
  config     Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  zones   Zone[]
  devices Device[]

  @@index([tenantId])
}

// ─── ZONE ────────────────────────────────────────────────────
model Zone {
  id         String   @id @default(uuid())
  tenantId   String
  buildingId String
  name       String
  floor      Int      @default(0)
  type       ZoneType @default(ROOM)

  building Building @relation(fields: [buildingId], references: [id])
  devices  Device[]

  @@index([tenantId])
  @@index([buildingId])
}

enum ZoneType {
  FLOOR
  APARTMENT
  ROOM
  CORRIDOR
  COMMON_AREA
  PARKING
}

// ─── DEVICE ──────────────────────────────────────────────────
model Device {
  id          String     @id @default(uuid())
  tenantId    String
  buildingId  String
  zoneId      String?
  name        String
  type        DeviceType
  protocol    Protocol   @default(MQTT)
  macAddress  String?    @unique
  isOnline    Boolean    @default(false)
  lastSeen    DateTime?
  config      Json       @default("{}")
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())

  building Building     @relation(fields: [buildingId], references: [id])
  zone     Zone?        @relation(fields: [zoneId], references: [id])
  states   DeviceState[]

  @@index([tenantId, buildingId])
  @@index([isOnline])
}

enum DeviceType {
  LIGHT
  PLUG
  SENSOR
  THERMOSTAT
  ENERGY_METER
  DOOR_SENSOR
}

enum Protocol {
  MQTT
  ZIGBEE
  WIFI
}

// ─── DEVICE STATE ─────────────────────────────────────────────
model DeviceState {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  tenantId  String
  state     Json
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id])
}

// ─── AUTOMATION ───────────────────────────────────────────────
model Automation {
  id          String    @id @default(uuid())
  tenantId    String
  buildingId  String
  name        String
  isActive    Boolean   @default(true)
  trigger     Json
  conditions  Json      @default("[]")
  action      Json
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, buildingId, isActive])
}

// ─── ALERT ────────────────────────────────────────────────────
model Alert {
  id         String    @id @default(uuid())
  tenantId   String
  buildingId String
  deviceId   String?
  type       AlertType
  severity   Severity  @default(WARNING)
  message    String
  metadata   Json      @default("{}")
  isRead     Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, buildingId, isRead])
}

enum AlertType {
  ENERGY_THRESHOLD
  DEVICE_OFFLINE
  AUTOMATION_FIRED
  ANOMALY
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

// ─── GATEWAY ─────────────────────────────────────────────────
model Gateway {
  id         String    @id @default(uuid())
  tenantId   String
  buildingId String
  name       String
  isOnline   Boolean   @default(false)
  lastSeen   DateTime?
  version    String?

  @@index([tenantId])
  @@index([buildingId])
}

// ─── API KEY ──────────────────────────────────────────────────
model ApiKey {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  key       String   @unique
  scope     String   @default("full") // "read", "write", "full", "gateway"
  isActive  Boolean  @default(true)
  requests  Int      @default(0)
  limit     Int      @default(50000)
  lastUsed  DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─── API LOG ──────────────────────────────────────────────────
model ApiLog {
  id         String   @id @default(uuid())
  tenantId   String
  method     String
  endpoint   String
  statusCode Int
  durationMs Int
  ip         String
  userId     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
}