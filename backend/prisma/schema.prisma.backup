generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  BUILDING_ADMIN
  OPERATOR
  VIEWER
}

enum SubscriptionPlan {
  BASIC
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

enum DeviceType {
  LIGHT
  PLUG
  SENSOR
  THERMOSTAT
  ENERGY_METER
  DOOR_SENSOR
}

enum Protocol {
  MQTT
  ZIGBEE
  WIFI
}

enum AlertType {
  THRESHOLD
  OFFLINE
  AUTOMATION
  SYSTEM
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum ZoneType {
  FLOOR
  APARTMENT
  ROOM
  CORRIDOR
  COMMON_AREA
  PARKING
}

model Tenant {
  id                  String                @id @default(uuid())
  name                String
  slug                String                @unique
  plan                SubscriptionPlan      @default(BASIC)
  subscriptionStatus  SubscriptionStatus    @default(ACTIVE)
  subscriptionEndsAt  DateTime?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  users               User[]
  buildings           Building[]
  apiKeys             ApiKey[]
  subscriptionHistory SubscriptionHistory[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(OPERATOR)
  jwtVersion   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model Building {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  address     String
  city        String       @default("Lubumbashi")
  unitsCount  Int          @default(0)
  config      Json         @default("{}")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  zones       Zone[]
  devices     Device[]
  automations Automation[]
  alerts      Alert[]
  gateways    Gateway[]

  @@index([tenantId])
}

model Zone {
  id         String   @id @default(uuid())
  tenantId   String
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  name       String
  floor      Int      @default(0)
  type       ZoneType @default(ROOM)
  devices    Device[]

  @@index([tenantId])
  @@index([buildingId])
}

model Device {
  id         String        @id @default(uuid())
  tenantId   String
  buildingId String
  zoneId     String?
  name       String
  type       DeviceType
  protocol   Protocol      @default(MQTT)
  macAddress String?       @unique
  isOnline   Boolean       @default(false)
  lastSeen   DateTime?
  config     Json          @default("{}")
  metadata   Json          @default("{}")
  createdAt  DateTime      @default(now())
  building   Building      @relation(fields: [buildingId], references: [id])
  zone       Zone?         @relation(fields: [zoneId], references: [id])
  states     DeviceState[]
  alerts     Alert[]

  @@index([tenantId, buildingId])
  @@index([isOnline])
}

model DeviceState {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  tenantId  String
  state     Json
  updatedAt DateTime @updatedAt
  device    Device   @relation(fields: [deviceId], references: [id])
}

model Automation {
  id          String    @id @default(uuid())
  tenantId    String
  buildingId  String
  name        String
  isActive    Boolean   @default(true)
  trigger     Json
  conditions  Json      @default("[]")
  action      Json
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  building    Building  @relation(fields: [buildingId], references: [id])

  @@index([tenantId, buildingId, isActive])
}

model Alert {
  id         String    @id @default(uuid())
  tenantId   String
  buildingId String
  deviceId   String?
  type       AlertType
  severity   Severity  @default(WARNING)
  message    String
  metadata   Json      @default("{}")
  isRead     Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  building   Building  @relation(fields: [buildingId], references: [id])
  device     Device?   @relation(fields: [deviceId], references: [id])

  @@index([tenantId, buildingId, isRead])
}

model Gateway {
  id         String    @id @default(uuid())
  tenantId   String
  buildingId String
  name       String
  isOnline   Boolean   @default(false)
  lastSeen   DateTime?
  version    String?
  building   Building  @relation(fields: [buildingId], references: [id])

  @@index([tenantId])
  @@index([buildingId])
}

model ApiKey {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  key       String    @unique
  scope     String    @default("full")
  isActive  Boolean   @default(true)
  requests  Int       @default(0)
  limit     Int       @default(50000)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ApiLog {
  id         String   @id @default(uuid())
  tenantId   String
  method     String
  endpoint   String
  statusCode Int
  durationMs Int
  ip         String
  userId     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
}

model SubscriptionHistory {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  plan              SubscriptionPlan
  status            SubscriptionStatus
  startDate         DateTime           @default(now())
  endDate           DateTime?
  paymentProvider   String?
  paymentProviderId String?
  amount            Float?
  currency          String?            @default("USD")
  createdAt         DateTime           @default(now())

  @@index([tenantId])
}
