@@ -0,0 +1,23 @@
+import type { Request, Response, NextFunction } from 'express';
+const SAFE_METHODS = new Set(['GET', 'HEAD', 'OPTIONS']);
+
+// Cookie-authenticated state changes must come from a configured browser origin.
+// Non-browser API clients using Authorization remain supported.
+export function enforceOrigin(req: Request, res: Response, next: NextFunction): void {
+  if (SAFE_METHODS.has(req.method)) return next();
+  const origin = req.headers.origin;
+  const allowed = (process.env.CORS_ORIGINS || 'http://localhost:3000')
+    .split(',').map(x => x.trim()).filter(Boolean);
+  if (origin && !allowed.includes(origin)) {
+    res.status(403).json({ error: 'Origin not allowed' });
+    return;
+  }
+  const cookiesPresent = Boolean(req.cookies?.access_token || req.cookies?.refresh_token);
+  const bearer = req.headers.authorization?.startsWith('Bearer ');
+  // Origin absent + cookie session: reject possible cross-site state changes.
+  if (cookiesPresent && !bearer && !origin) {
+    res.status(403).json({ error: 'Origin required for cookie authentication' });
+    return;
+  }
+  next();
+}
