+/** A device ACK is a reported state, not proof of a physical safety contactor position. */
+async function handleCommandAck(scope: DeviceScope, event: Record<string, unknown>, io: Server): Promise<void> {
+  if (event.type !== 'command_ack') return;
+  const commandId = event.commandId;
+  const status = event.status;
+  if (typeof commandId !== 'string' || !z.string().uuid().safeParse(commandId).success ||
+      !['ACKNOWLEDGED', 'CONFIRMED', 'FAILED'].includes(String(status))) return;
+  const observed = event.observedState;
+  if (status === 'CONFIRMED' && (!isRecord(observed) || !['on', 'off'].includes(String(observed.state)))) return;
+  const current = await prisma.deviceCommand.findFirst({
+    where: {
+      id: commandId, tenantId: scope.tenantId, buildingId: scope.buildingId,
+      deviceId: scope.deviceId, expiresAt: { gt: new Date() },
+      status: { in: ['PENDING', 'SENT', 'ACKNOWLEDGED'] },
+    },
+  });
+  if (!current) return;
+  // Never accept confirmation of a different state than the command requested.
+  if (status === 'CONFIRMED' && isRecord(current.params) && current.params.state !== (observed as Record<string, unknown>).state) return;
+  if (status === 'ACKNOWLEDGED' && current.status === 'ACKNOWLEDGED') return;
+  const updated = await prisma.deviceCommand.updateMany({
+    where: { id: current.id, expiresAt: { gt: new Date() },
+      status: { in: status === 'ACKNOWLEDGED' ? ['PENDING', 'SENT'] : ['PENDING', 'SENT', 'ACKNOWLEDGED'] } },
+    data: {
+      status: status as 'ACKNOWLEDGED' | 'CONFIRMED' | 'FAILED',
+      ...(status === 'ACKNOWLEDGED' ? { acknowledgedAt: new Date() } : {}),
+      ...(status === 'CONFIRMED' ? { confirmedAt: new Date(), observedState: { state: (observed as { state: string }).state } } : {}),
+      ...(status === 'FAILED' ? { failedAt: new Date(), error: 'Device reported failure' } : {}),
+    },
+  });
+  if (!updated.count) return;
+  if (status === 'CONFIRMED') {
+    await prisma.deviceState.upsert({
+      where: { deviceId: scope.deviceId },
+      update: { tenantId: scope.tenantId, state: { state: (observed as { state: string }).state } },
+      create: { deviceId: scope.deviceId, tenantId: scope.tenantId, state: { state: (observed as { state: string }).state } },
+    });
+  }
+  io.to(`building:${scope.buildingId}`).emit('device:command', {
+    deviceId: scope.deviceId, commandId, status,
+  });
+}
