# ============================================================
# AFRIXORA — Modèle de configuration pour start-demo.sh
# Copier ce fichier en .env.demo puis remplacer TOUS les CHANGE_ME.
# .env.demo n'est JAMAIS versionné (voir .gitignore).
# ============================================================

# --- Base de données locale (conteneur Docker afrixora-postgres) ---
POSTGRES_USER=afrixora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=afrixora_dev
DATABASE_URL=postgresql://afrixora:CHANGE_ME@localhost:5432/afrixora_dev?schema=public

# --- Redis local (conteneur Docker afrixora-redis) ---
REDIS_URL=redis://localhost:6379

# --- MQTT local (conteneur Docker afrixora-mosquitto) ---
MQTT_URL=mqtt://localhost:1883
MQTT_API_USER=afrixora_api
MQTT_API_PASSWORD=CHANGE_ME

# --- JWT (générer avec : openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Resend) — utiliser une clé de test, jamais la clé de production ---
RESEND_API_KEY=re_CHANGE_ME

# --- Frontend / CORS ---
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Domaine (localhost en démo) ---
DOMAIN=localhost

# --- Backend ---
PORT=4000

# --- Business ---
ENERGY_COST_PER_KWH=0.12

# --- Compte admin de démo créé par le seed (jamais en production) ---
SEED_ADMIN_PASSWORD=CHANGE_ME
